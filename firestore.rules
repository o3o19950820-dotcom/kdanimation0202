rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 홈페이지 공개 콘텐츠는 읽기만 허용.
    // 쓰기는 Vercel의 Firebase Admin SDK를 통해서만 처리합니다.
    match /site/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // 고객 문의는 브라우저에서 Firestore 직접 접근 금지.
    // /api/inquiries, /api/admin 서버 함수만 접근합니다.
    match /inquiries/{document=**} {
      allow read, write: if false;
    }

    // 그 외 모든 경로 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
